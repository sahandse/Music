{
  "name": "music-server",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted, Subsonic-compatible personal music server. Indexes audio files from a local folder only.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "create-user": "ts-node src/scripts/createUser.ts",
    "scan": "ts-node src/scripts/scan.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  }
}
